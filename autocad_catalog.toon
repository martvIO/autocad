// ─────────────────────────────────────────────────────────────────────────────
// POLYLINE CLIP  (TRA_LSP\TRA_EPOL.LSP)
// ─────────────────────────────────────────────────────────────────────────────

{
    name: "epol"
    type: command
    source_file: "TRA_LSP\\TRA_EPOL.LSP"
    description: "Erase entities inside or outside a closed polyline boundary. Optionally cuts lines that cross the boundary."
    parameters: [
        {name:"boundary_polyline", type:"pick"},
        {name:"erase_mode", type:"keyword", options:["Inside","Outside"]},
        {name:"cut_crossing", type:"keyword", options:["Yes","No"]},
        {name:"selection_method", type:"keyword", options:["Window","Crossing"]}
    ]
    side_effects: "Erases/offsets/trims entities; restores zoom"
}

// ─────────────────────────────────────────────────────────────────────────────
// IMAGE HELMERT TRANSFORMATION  (TRA_LSP\Image_helmert.lsp)
// ─────────────────────────────────────────────────────────────────────────────

{
    name: "tr_Image_Helmrt_trans"
    type: command
    source_file: "TRA_LSP\\Image_helmert.lsp"
    description: "Graphical Helmert (4-parameter conformal) coordinate transformation. Collect >= 2 source/target control point pairs interactively; compute least-squares translation (dx,dy), rotation (w), scale (q); apply to selected entities."
    parameters: [
        {name:"control_point_pairs", type:"interactive", description:">= 2 pairs of source and target points"},
        {name:"entities", type:"pick-set", description:"Entities to transform"}
    ]
    side_effects: "Modifies entity coordinates via entmod"
}

// ─────────────────────────────────────────────────────────────────────────────
// SYMBOL MANAGEMENT  (TRA_LSP\tr_symbol.lsp)
// ─────────────────────────────────────────────────────────────────────────────

{
    name: "tr_update_symbols"
    type: command
    source_file: "TRA_LSP\\tr_symbol.lsp"
    description: "Update point symbol codes. Interactive: display 13-symbol list, user picks number, selects points, updates block/layer/TRSYMBOL xdata."
    parameters: [
        {name:"symbol_number", type:"integer", description:"1-13 selection from list"},
        {name:"points", type:"pick-set"}
    ]
    side_effects: "Updates entity block layer and TRSYMBOL xdata via entmod"
}

{
    name: "tr_query_symbol"
    type: command
    source_file: "TRA_LSP\\tr_symbol.lsp"
    description: "Query symbol information stored in entity xdata (app TRSYMBOL)."
    parameters: [{name:"entity", type:"pick"}]
    returns: "Prints symbol name and description to console"
}

{
    name: "tr_list_symbols"
    type: command
    source_file: "TRA_LSP\\tr_symbol.lsp"
    description: "Display all 13 available point symbols with codes and descriptions."
    parameters: []
    returns: "Console output only"
}

{
    name: "tr_batch_update_by_layer"
    type: command
    source_file: "TRA_LSP\\tr_symbol.lsp"
    description: "Batch update all POINT entities on a named layer to a specified symbol."
    parameters: [
        {name:"layer_name", type:"string"},
        {name:"symbol_name", type:"string", description:"Must be valid symbol name from library"}
    ]
}

// ─────────────────────────────────────────────────────────────────────────────
// SYMBOL CODE UPDATE  (TRA_LSP\tr_updcode.lsp)
// ─────────────────────────────────────────────────────────────────────────────

{
    name: "TRUPDCODE"
    type: command
    source_file: "TRA_LSP\\tr_updcode.lsp"
    description: "Update MapPit point symbol code and mark without interactive dialog. Three-tier entity finding: (1) scan all INSERTs for TAG=NAME match, (2) trmfindp ARX pan-to-point, (3) manual entsel. Reads Hanit_Pcod.INI for new block/layer; loads block if needed; updates INSERT+MARK via entmod."
    parameters: [
        {name:"point_name", type:"string", description:"Point name to find"},
        {name:"new_code", type:"string", description:"New symbol code (must exist in Hanit_Pcod.INI)"},
        {name:"new_mark", type:"string", description:"New mark value (Enter to keep current)"}
    ]
    side_effects: "Modifies INSERT block name, layer, MARK attribute via entmod"
}

// ─────────────────────────────────────────────────────────────────────────────
// ELEVATION LABEL THINNING  (TRA_LSP\tr_thin.lsp)
// ─────────────────────────────────────────────────────────────────────────────

{
    name: "THINHEIGHTS"
    type: command
    source_file: "TRA_LSP\\tr_thin.lsp"
    description: "Thin elevation height labels. Selects area (rectangle or polyline), reads HEIGHTM_ATT tags from Hanit_Pcod.INI, finds M1502_P INSERT height ATTRIBs, applies greedy radius-based thinning sorted by elevation descending, hides redundant ATTRIBs by setting DXF code-70 invisible bit, saves original flags in TRTHIN xdata."
    parameters: [
        {name:"area_mode", type:"keyword", options:["Rectangle","Polyline"]},
        {name:"boundary", type:"pick-or-corners", description:"Polyline ename or two rectangle corners"},
        {name:"radius", type:"real", description:"Thinning radius in drawing units (default 10.0)"},
        {name:"elevation_tolerance", type:"real", description:"Elevation closeness threshold (default 0.05)"}
    ]
    side_effects: "Sets ATTRIB invisible flag bit via entmod; writes TRTHIN xdata; calls entupd on parent INSERTs"
}

{
    name: "RESTOREHEIGHTS"
    type: command
    source_file: "TRA_LSP\\tr_thin.lsp"
    description: "Restore elevation labels hidden by THINHEIGHTS. Finds all ATTRIBs with TRTHIN xdata; restores original DXF code-70 flags; calls entupd on M1502_P parent INSERTs."
    parameters: []
    side_effects: "Restores ATTRIB invisible flag via entmod; removes TRTHIN xdata"
}

// ─────────────────────────────────────────────────────────────────────────────
// DEMO / UTILITY COMMANDS  (TRA_LSP\DEMO.LSP)
// ─────────────────────────────────────────────────────────────────────────────

{
    name: "fff"
    type: command
    source_file: "TRA_LSP\\DEMO.LSP"
    description: "Interactive polyline join: pick starting line/arc/polyline, repeatedly join next selected objects into a continuous fitted polyline."
    parameters: [{name:"start_entity", type:"pick"}, {name:"join_entities", type:"pick-loop"}]
}

{
    name: "dist1"
    type: command
    source_file: "TRA_LSP\\DEMO.LSP"
    description: "Show distance label for one picked line. Inserts TR_FRONT block at midpoint. Loops until no more lines picked."
    parameters: [{name:"line", type:"pick-loop"}]
    arx_call: "trpins_a(\"TR_FRONT\",...)"
}

{
    name: "dist2"
    type: command
    source_file: "TRA_LSP\\DEMO.LSP"
    description: "Show distance label between two picked points. Inserts TR_FRONT block at midpoint. Loops."
    parameters: [{name:"p1", type:"point"}, {name:"p2", type:"point"}]
}

{
    name: "ddd"
    type: command
    source_file: "TRA_LSP\\DEMO.LSP"
    description: "Simple distance measurement — pick two points, print distance to console. No height factor."
    parameters: [{name:"p1", type:"point"}, {name:"p2", type:"point"}]
    returns: "Prints distance string to console"
}

{
    name: "att2pt"
    type: command
    source_file: "TRA_LSP\\DEMO.LSP"
    description: "Elevate attribute text positions to match INSERT block Z height for selected INSERT entities."
    parameters: [{name:"inserts", type:"pick-set", description:"INSERT entities"}]
    side_effects: "Modifies ATTRIB group-10/11 Z coordinates via entmod"
}

{
    name: "ob_chg"
    type: command
    source_file: "TRA_LSP\\DEMO.LSP"
    description: "Set oblique angle (DXF code 51) of selected text entities to 0. Fixes IntelliCAD oblique angle issue."
    parameters: [{name:"texts", type:"pick-set"}]
    side_effects: "Sets code-51=0 on all selected TEXT entities via entmod"
}

{
    name: "xxx"
    type: command
    source_file: "TRA_LSP\\tr_pschg.lsp"
    description: "Debug: pick entity, print its NOTR_DXF extended data group -3 to console."
    parameters: [{name:"entity", type:"pick"}]
    returns: "Prints xdata to console"
}

