// ─────────────────────────────────────────────────────────────────────────────
// MENU LOADING COMMANDS  (TRA_ARX.LSP)
// ─────────────────────────────────────────────────────────────────────────────

{
    name: "pitmenu"
    type: command
    source_file: "TRA_ARX.LSP"
    description: "Load English Pitronim main menu (pit_sub.mnu). Sets menubar=1 for acver>=17.2. Activates pop20-pop23."
    parameters: []
    returns: "nil"
    side_effects: "Loads pit_sub.mnu; sets menubar system variable"
}

{
    name: "hebmenu"
    type: command
    source_file: "TRA_ARX.LSP"
    description: "Load Hebrew Pitronim main menu (pit_heb.mnu). Activates pop20-pop23."
    parameters: []
    returns: "nil"
    side_effects: "Loads pit_heb.mnu"
}

{
    name: "tabamenu"
    type: command
    source_file: "TRA_ARX.LSP"
    description: "Load TABA land-use menu (tr_taba.mnu). Activates pop24."
    parameters: []
    returns: "nil"
    side_effects: "Loads tr_taba.mnu"
}

{
    name: "mamimenu"
    type: command
    source_file: "TRA_ARX.LSP"
    description: "Load MAMI Hebrew menu (mami_heb.mnu)."
    parameters: []
    returns: "nil"
    side_effects: "Loads mami_heb.mnu"
}

{
    name: "pit"
    type: command
    source_file: "TRA_ARX.LSP"
    description: "Legacy load command. Loads tra_lsp if not loaded; arxloads pit14.arx or pit95.arx."
    parameters: []
    returns: "nil"
    side_effects: "May arxload legacy binary"
}

